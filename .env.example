# ─── App ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Secret for the Supabase "Send Email" auth hook (format: v1,whsec_xxx)
SUPABASE_AUTH_HOOK_SECRET=
# Google sign-in: enable the Google provider in Supabase (Authentication → Providers → Google).
# The "Continue with Google" button is always shown.

# ─── Resend ─────────────────────────────────────────────────────────
RESEND_API_KEY=
# Alternative delivery over SMTP (used when RESEND_API_KEY is empty), e.g. smtp://127.0.0.1:54325 for local Mailpit
SMTP_URL=
EMAIL_FROM="Pintevact <hello@pintevact.com>"
# Signs learners' unsubscribe links (any long random string; falls back to the service-role key)
EMAIL_UNSUBSCRIBE_SECRET=
# Where contact-form messages are delivered
CONTACT_INBOX=team@pintevact.com

# ─── Stripe ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
# Optional API origin override, only for Stripe's stripe-mock server in tests (http://localhost:12111)
STRIPE_API_BASE=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Recurring prices for the All-Access membership
STRIPE_PRICE_MEMBERSHIP_MONTHLY=
STRIPE_PRICE_MEMBERSHIP_YEARLY=

# ─── Bunny.net Stream ───────────────────────────────────────────────
BUNNY_STREAM_LIBRARY_ID=
# Stream library API key (used by admin to list/verify videos)
BUNNY_STREAM_API_KEY=
# CDN hostname of the stream library pull zone, e.g. vz-abc123-456.b-cdn.net
BUNNY_STREAM_CDN_HOSTNAME=
# Pull zone "Token Authentication" key (Security → Token Authentication)
BUNNY_STREAM_TOKEN_KEY=
# Signed URL lifetime in seconds
BUNNY_STREAM_TOKEN_TTL=14400

# ─── Cron (weekly digests / streak reminders) ───────────────────────
CRON_SECRET=
