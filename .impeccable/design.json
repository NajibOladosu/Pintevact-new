      "description": "10px field with strong hairline; focus goes to ink border plus a 25% orange ring.",
      "html": "<label class=\"ds-label\" for=\"ds-email\">Email</label><input id=\"ds-email\" class=\"ds-input\" placeholder=\"you@example.com\">",
      "css": ":host{--bg:#f8f2ea;--raised:#fffbf6;--sunken:#efe7db;--fg:#11101c;--muted:#4d4859;--subtle:#6a6475;--line:rgb(17 16 28/.12);--line-strong:rgb(17 16 28/.24);--accent:#ee4216;--accent-hover:#d93a10;--accent-ink:#b5300c;--on-accent:#11101c;--violet:#361a6a;--on-violet:#f8f2ea;--on-violet-muted:#cbbfe0;--focus:#361a6a;--ease-out-expo:cubic-bezier(0.16,1,0.3,1);font-family:'Geist',ui-sans-serif,system-ui,sans-serif;} .ds-label{display:block;margin-bottom:8px;font:500 .875rem/1.4 'Geist',sans-serif;color:var(--fg);} .ds-input{width:100%;height:44px;padding:0 14px;border-radius:10px;border:1px solid var(--line-strong);background:var(--raised);color:var(--fg);caret-color:var(--accent);font:400 1rem 'Geist',sans-serif;transition:border-color .15s,box-shadow .15s;} .ds-input::placeholder{color:var(--subtle);} .ds-input:focus{outline:none;border-color:var(--fg);box-shadow:0 0 0 2px rgb(238 66 22/.25);}"
    },
