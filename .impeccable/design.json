  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Signal Orange with Night Ink label; the one primary action per view (Start free).",
      "html": "<button class=\"ds-btn ds-btn-primary\">Start free</button>",
      "css": ":host{--bg:#f8f2ea;--raised:#fffbf6;--sunken:#efe7db;--fg:#11101c;--muted:#4d4859;--subtle:#6a6475;--line:rgb(17 16 28/.12);--line-strong:rgb(17 16 28/.24);--accent:#ee4216;--accent-hover:#d93a10;--accent-ink:#b5300c;--on-accent:#11101c;--violet:#361a6a;--on-violet:#f8f2ea;--on-violet-muted:#cbbfe0;--focus:#361a6a;--ease-out-expo:cubic-bezier(0.16,1,0.3,1);font-family:'Geist',ui-sans-serif,system-ui,sans-serif;} .ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:44px;padding:0 20px;border-radius:10px;font:500 0.95rem/1 'Geist',ui-sans-serif,system-ui,sans-serif;border:0;cursor:pointer;transition:background-color .15s,border-color .15s,color .15s,transform .15s;} .ds-btn:active{transform:translateY(1px);} .ds-btn:focus-visible{outline:2px solid var(--focus,#361a6a);outline-offset:2px;} .ds-btn-primary{background:var(--accent);color:var(--on-accent);} .ds-btn-primary:hover{background:var(--accent-hover);}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "The quiet partner to Primary (See courses): strong hairline border, ink on hover.",
      "html": "<button class=\"ds-btn ds-btn-outline\">See courses</button>",
      "css": ":host{--bg:#f8f2ea;--raised:#fffbf6;--sunken:#efe7db;--fg:#11101c;--muted:#4d4859;--subtle:#6a6475;--line:rgb(17 16 28/.12);--line-strong:rgb(17 16 28/.24);--accent:#ee4216;--accent-hover:#d93a10;--accent-ink:#b5300c;--on-accent:#11101c;--violet:#361a6a;--on-violet:#f8f2ea;--on-violet-muted:#cbbfe0;--focus:#361a6a;--ease-out-expo:cubic-bezier(0.16,1,0.3,1);font-family:'Geist',ui-sans-serif,system-ui,sans-serif;} .ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:44px;padding:0 20px;border-radius:10px;font:500 0.95rem/1 'Geist',ui-sans-serif,system-ui,sans-serif;border:0;cursor:pointer;transition:background-color .15s,border-color .15s,color .15s,transform .15s;} .ds-btn:active{transform:translateY(1px);} .ds-btn:focus-visible{outline:2px solid var(--focus,#361a6a);outline-offset:2px;} .ds-btn-outline{background:transparent;color:var(--fg);border:1px solid var(--line-strong);} .ds-btn-outline:hover{border-color:var(--fg);background:rgb(17 16 28/.03);}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Inverted ink fill; used for Dashboard when signed in.",
      "html": "<button class=\"ds-btn ds-btn-secondary\">Dashboard</button>",
